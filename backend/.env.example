PORT=3001
BASE_URL=http://localhost:5173
JWT_SECRET=degistir-beni
ADMIN_PASSWORD=admin123
SEED_USER_PASSWORD=admin123
STORAGE_DRIVER=local
# R2 (Cloudflare) — yalnızca STORAGE_DRIVER=r2 iken zorunlu. S3-uyumlu API;
# eksikse uygulama açılışta fail-fast eder. R2_REGION varsayılan 'auto'.
# R2_ENDPOINT=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# Yedek çıktı dizini + saklanan yedek sayısı. Geliştirmede varsayılan
# `backend/backups` ve en yeni 10. Üretimde render.yaml `BACKUPS_DIR=/var/data/backups`.
# BACKUPS_DIR=
# BACKUP_KEEP=10
# Login brute-force limiti (15 dk penceresi). Varsayılan: 5 (production).
# Demo ortamında 10'a kadar gevşetilebilir. 100+ KESİNLİKLE kullanmayın.
# LOGIN_RATE_LIMIT_MAX=5
# Hassas uçlar (Bulgu #7). Anahtar kullanıcı ID'sidir (IP değil).
# change-password 15 dk, import/backup 1 saat penceresi kullanır.
# CHANGE_PASSWORD_RATE_LIMIT_MAX=5
# ADMIN_IMPORT_RATE_LIMIT_MAX=5
# ADMIN_BACKUP_RATE_LIMIT_MAX=3
